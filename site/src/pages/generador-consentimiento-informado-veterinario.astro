---
import Base from "../layouts/Base.astro";

const fields = [
  {
    legend: "Datos de la clínica",
    rows: [
      [{ name: "clinica", label: "Nombre de la clínica" }, { name: "mvz", label: "Médico veterinario" }],
      [{ name: "matricula", label: "Matrícula profesional" }, { name: "fecha", label: "Fecha", type: "date" }],
    ],
  },
  {
    legend: "Propietario",
    rows: [
      [{ name: "propietario", label: "Nombre del propietario" }, { name: "documento", label: "Documento" }],
      [{ name: "telefono", label: "Teléfono" }, { name: "direccion", label: "Dirección" }],
    ],
  },
  {
    legend: "Paciente",
    rows: [
      [{ name: "paciente", label: "Nombre del paciente" }, { name: "especie", label: "Especie" }],
      [{ name: "raza", label: "Raza" }, { name: "sexo", label: "Sexo" }],
      [{ name: "edad", label: "Edad" }, { name: "microchip", label: "Microchip / identificación" }],
    ],
  },
];

const areas = [
  { name: "procedimiento", label: "Procedimiento o tratamiento propuesto" },
  { name: "riesgos", label: "Riesgos y complicaciones posibles" },
  { name: "alternativas", label: "Alternativas al procedimiento" },
  { name: "anestesia", label: "Plan anestésico y sus riesgos (si aplica)" },
  { name: "observaciones", label: "Observaciones" },
];
---

<Base
  title="Generador de consentimiento informado veterinario — descarga editable (Word)"
  description="Genera y descarga el consentimiento informado veterinario por procedimiento, editable en Word y según la Ley 576. Gratis, sin registro."
  path="/generador-consentimiento-informado-veterinario"
>
  <section class="wrap gen">
    <header class="gen__head">
      <p class="eyebrow">Generador gratis · sin registro</p>
      <h1>Generador de consentimiento informado veterinario</h1>
      <p class="muted gen__sub">
        Arma el consentimiento por procedimiento y descárgalo en Word, listo para que el
        propietario lo firme. Exigido por la Ley 576. Nada se sube a ningún lado — se genera en tu navegador.
      </p>
    </header>

    <div class="gen__grid">
      <form id="hc-form" class="gen__form">
        {fields.map((group) => (
          <fieldset class="card">
            <legend>{group.legend}</legend>
            {group.rows.map((row) => (
              <div class="field-row">
                {row.map((f) => (
                  <label class="field">
                    <span>{f.label}</span>
                    <input type={f.type ?? "text"} name={f.name} autocomplete="off" />
                  </label>
                ))}
              </div>
            ))}
          </fieldset>
        ))}

        <fieldset class="card">
          <legend>Procedimiento</legend>
          {areas.map((a) => (
            <label class="field">
              <span>{a.label}</span>
              <textarea name={a.name} rows="3"></textarea>
            </label>
          ))}
        </fieldset>
      </form>

      <aside class="gen__side">
        <div class="card gen__actions">
          <button id="download" class="btn btn-primary" type="button">
            <svg class="icon" viewBox="0 0 24 24"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Descargar en Word
          </button>
          <button id="clear" class="btn btn-tint" type="button">Limpiar</button>
          <p class="muted gen__hint">Se descarga un archivo <strong>.doc</strong> con el texto legal y los espacios de firma, editable en Word, Google Docs o LibreOffice.</p>
        </div>

        <div class="card gen__upsell">
          <h3>¿Lo quieres junto a la historia?</h3>
          <p class="muted">
            El consentimiento es un anexo de la historia clínica. En la app queda guardado con el paciente.
          </p>
          <a class="btn btn-tint" href="/generador-historia-clinica-veterinaria">Generar historia clínica</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("hc-form") as HTMLFormElement;
  const labels: Record<string, string> = {};
  form.querySelectorAll<HTMLElement>(".field").forEach((field) => {
    const control = field.querySelector<HTMLInputElement | HTMLTextAreaElement>("[name]");
    const span = field.querySelector("span");
    if (control && span) labels[control.name] = span.textContent ?? control.name;
  });

  function value(name: string): string {
    const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    return (el?.value ?? "").trim();
  }

  function row(name: string): string {
    const v = value(name) || "—";
    return `<tr><td class="k">${labels[name]}</td><td>${v.replace(/\n/g, "<br>")}</td></tr>`;
  }

  function buildDoc(): string {
    const groups = [
      ["Clínica", ["clinica", "mvz", "matricula", "fecha"]],
      ["Propietario", ["propietario", "documento", "telefono", "direccion"]],
      ["Paciente", ["paciente", "especie", "raza", "sexo", "edad", "microchip"]],
      ["Procedimiento", ["procedimiento", "riesgos", "alternativas", "anestesia", "observaciones"]],
    ] as const;

    const sections = groups
      .map(([title, names]) => `<h2>${title}</h2><table>${names.map(row).join("")}</table>`)
      .join("");

    const propietario = value("propietario") || "el propietario";
    const paciente = value("paciente") || "el paciente";

    return `<!doctype html><html><head><meta charset="utf-8"><style>
      body{font-family:Calibri,Arial,sans-serif;color:#16201b;}
      h1{font-size:20pt;margin:0 0 2pt;}
      .sub{color:#4a5852;font-size:10pt;margin:0 0 16pt;}
      h2{font-size:12pt;background:#eef4f0;padding:4pt 8pt;margin:14pt 0 4pt;}
      table{width:100%;border-collapse:collapse;}
      td{border:1px solid #dde3df;padding:5pt 8pt;font-size:10.5pt;vertical-align:top;}
      td.k{width:32%;color:#4a5852;font-weight:bold;background:#f7f8f6;}
      .decl{font-size:10.5pt;margin:16pt 0;text-align:justify;}
      .firmas{width:100%;margin-top:36pt;}
      .firmas td{border:0;padding-top:24pt;font-size:10pt;text-align:center;width:50%;}
      .linea{border-top:1px solid #16201b;padding-top:4pt;}
    </style></head><body>
      <h1>Consentimiento Informado Veterinario</h1>
      <p class="sub">Conforme a la Ley 576 de 2000 · generado en veterinaria.geosdata.com</p>
      ${sections}
      <p class="decl">Yo, ${propietario}, en calidad de propietario o responsable de ${paciente},
      declaro que he sido informado en lenguaje claro y comprensible sobre el procedimiento propuesto,
      sus riesgos, complicaciones y alternativas descritos en este documento; que pude hacer preguntas y
      fueron resueltas; y que <strong>autorizo de forma libre y voluntaria</strong> su realización por parte del
      médico veterinario responsable. Entiendo que la medicina veterinaria no ofrece garantía de resultados.</p>
      <table class="firmas"><tr>
        <td><div class="linea">Firma del propietario</div></td>
        <td><div class="linea">Firma del MV/MVZ · Matrícula ${value("matricula") || "____"}</div></td>
      </tr></table>
    </body></html>`;
  }

  function slug(): string {
    const p = value("paciente").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    return p ? `consentimiento-${p}` : "consentimiento-informado-veterinario";
  }

  document.getElementById("download")?.addEventListener("click", () => {
    const blob = new Blob(["﻿", buildDoc()], { type: "application/msword" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${slug()}.doc`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById("clear")?.addEventListener("click", () => {
    if (confirm("¿Limpiar todos los campos?")) form.reset();
  });
</script>

<style>
  .gen { padding: 2.5rem 1.25rem 0; }
  .gen__head { max-width: 60ch; margin-bottom: 2rem; }
  .gen__sub { font-size: 1.05rem; }
  .gen__grid { display: grid; grid-template-columns: 1fr 20rem; gap: 1.5rem; align-items: start; }
  .gen__form { display: grid; gap: 1.25rem; }
  fieldset { border: 1px solid var(--line); }
  legend {
    font-family: var(--font-display); font-weight: 600; font-size: 0.85rem;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--pine-700);
    padding: 0 0.5rem;
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-bottom: 0.9rem; }
  .field-row:last-child { margin-bottom: 0; }
  .field { display: grid; gap: 0.3rem; }
  .field span { font-size: 0.82rem; color: var(--ink-soft); font-weight: 500; }
  input, textarea {
    font-family: var(--font-body); font-size: 0.98rem; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.55rem 0.7rem; width: 100%; resize: vertical;
  }
  input:focus, textarea:focus { outline: 2px solid var(--pine-300); border-color: var(--pine-300); }
  fieldset:last-child .field { margin-bottom: 0.9rem; }
  fieldset:last-child .field:last-child { margin-bottom: 0; }
  .gen__side { position: sticky; top: 5rem; display: grid; gap: 1.25rem; }
  .gen__actions { display: grid; gap: 0.75rem; }
  .gen__hint { font-size: 0.82rem; margin: 0.25rem 0 0; }
  .gen__upsell h3 { margin-bottom: 0.4rem; }
  @media (max-width: 820px) {
    .gen__grid { grid-template-columns: 1fr; }
    .gen__side { position: static; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>
